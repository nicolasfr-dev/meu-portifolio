---
import Talk from "./Talk.astro";
import Key from "./Key.astro";
import { profile, type Lang } from "../data/profile";
import { useT } from "../i18n/ui";

interface Props {
    lang: Lang;
    nav: { id: string; label: string; help: string }[];
}

const { lang, nav } = Astro.props;
const t = useT(lang);
const years = Math.max(1, new Date().getFullYear() - profile.startedCodingYear);
const [first] = profile.name.split(" ");
const systemHelp = t("help.system");
const intro = t("hero.intro");
---

<section class="hero" id="start" data-stage aria-labelledby="hero-title">
    <!-- cenário: painel azul diagonal com a superfície da água vista de baixo, como no menu do jogo -->
    <div class="hero-panel hero-enter" aria-hidden="true">
        <div class="hero-water"><i></i></div>
    </div>
    <div class="hero-cut hero-enter" aria-hidden="true"></div>

    <!-- o comando selecionado aparece gigante ao fundo, como no menu do jogo -->
    <p class="hero-bigword" data-bigword aria-hidden="true">
        {nav[0]?.label}
    </p>

    <!-- faixas diagonais atrás do retrato, como nos cut-ins do jogo -->
    <div class="hero-stripes hero-enter" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
    </div>

    {profile.photo ? (
        // foto recortada: a figura inteira, sem moldura, com a sombra azul deslocada
        <img
            class="hero-figure hero-enter"
            src={profile.photo}
            alt={t("hero.photo")}
            width={profile.photoSize.width}
            height={profile.photoSize.height}
            fetchpriority="high"
        />
    ) : (
        <div class="hero-photo slant">
            <svg class="unslant" viewBox="0 0 260 360" aria-hidden="true">
                <circle cx="130" cy="120" r="66" class="silhouette" />
                <path
                    d="M20 360 C 26 260, 70 214, 130 214 S 234 260, 240 360 Z"
                    class="silhouette"
                />
            </svg>
        </div>
    )}

    <div class="container hero-grid">
        <header class="hero-plate hero-enter">
            <h1 id="hero-title">
                <span class="hero-lv tag">
                    <span>LV {years}</span>
                </span>
                <span class="hero-name">{profile.name}</span>
            </h1>
            <p class="hero-role">{profile.role[lang]}</p>
            {profile.photo && (
                // celular: o retrato vira um busto ao lado do nome
                <span class="hero-mbust" aria-hidden="true">
                    <img
                        src={profile.photo}
                        alt=""
                        width={profile.photoSize.width}
                        height={profile.photoSize.height}
                    />
                </span>
            )}
        </header>

        <nav class="hero-menu" aria-label="Menu" data-cmd-root>
            <ul class="cmd" role="list" data-cmd data-bigword-source>
                {nav.map((n, i) => (
                    <li style={`--i:${i}`}>
                        <a
                            href={`#${n.id}`}
                            data-help={n.help}
                            data-label={n.label}
                            data-press-start
                            class:list={{ "is-selected": i === 0 }}
                        >
                            <span class="cmd-label">
                                <span class="cursor" aria-hidden="true" />
                                {n.label}
                            </span>
                        </a>
                    </li>
                ))}
                <li style={`--i:${nav.length}`}>
                    <a
                        href="#system"
                        data-open="pause"
                        data-help={systemHelp}
                        data-label={t("nav.system")}
                    >
                        <span class="cmd-label">
                            <span class="cursor" aria-hidden="true" />
                            {t("nav.system")}
                        </span>
                    </a>
                </li>
            </ul>
        </nav>

        <Talk
            speaker={first}
            label={t("a11y.intro")}
            class="hero-dialog hero-enter"
        >
            <!-- a fala é "digitada" na entrada; o texto completo fica disponível para leitores de tela -->
            <p class="hero-intro">
                <span class="sr-only">{intro}</span>
                <span aria-hidden="true" data-typewriter>
                    {intro}
                </span>
            </p>

            <!-- escolhas de resposta, saindo da fala como no jogo -->
            <nav class="hero-choices choice-box" aria-label={t("hero.choices")}>
                <ul class="choice-list" role="list" data-cmd>
                    <li>
                        <a href="#quests" data-press-start>
                            {t("hero.choice.projects")}
                        </a>
                    </li>
                    <li>
                        <a
                            href={profile.cvUrl}
                            download={profile.cvUrl !== "#" ? "" : undefined}
                        >
                            {t("hero.choice.cv")}
                        </a>
                    </li>
                    <li>
                        <a href="#contact" data-contact>
                            {t("hero.choice.contact")}
                        </a>
                    </li>
                </ul>
            </nav>
        </Talk>

        <div class="hero-side hero-enter">
            <p class="hero-help" data-cmd-help aria-live="polite">
                {nav[0]?.help}
            </p>
            <p class="hero-keys">
                <span>
                    <Key name="up" lang={lang} />
                    <Key name="down" lang={lang} />
                    {t("keys.nav")}
                </span>
                <span class="hero-key-main">
                    <Key name="enter" lang={lang} />
                    {t("keys.confirm")}
                </span>
                <span>
                    <Key name="esc" lang={lang} />
                    {t("hud.menu")}
                </span>
            </p>
        </div>
    </div>
</section>

<style>
    .hero {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        min-height: min(100svh, 54rem);
        padding-top: calc(var(--hud-h) + env(safe-area-inset-top) + 1rem);
        padding-bottom: 1.5rem;
        isolation: isolate;
    }

    /* ---- cenário ---- */
    .hero-panel {
        position: absolute;
        z-index: -4;
        inset: -10% -25% -10% 34%;
        overflow: hidden;
        background: linear-gradient(
            160deg,
            var(--azure) 0%,
            var(--royal) 55%,
            var(--deep) 100%
        );
        transform: skewX(var(--skew));
    }

    /* superfície da água vista de baixo, como no menu do jogo: um leque que desce do topo,
       massa clara com fendas no alto que se quebra em lascas horizontais e some.
       A cor é o --accent (véu + textura), então o tema carmesim funciona igual */
    .hero-water {
        position: absolute;
        /* começa logo abaixo do HUD (o painel sobra 10% da altura do hero para cima) */
        top: calc(8.33% + var(--hud-h));
        left: 0;
        right: 0;
        height: 33%;
        overflow: hidden;
        background: linear-gradient(
            color-mix(in srgb, var(--accent) 65%, transparent),
            color-mix(in srgb, var(--accent) 25%, transparent) 60%,
            transparent
        );
        /* o leque: largo no alto e afunilando em V, descendo mais no meio */
        mask-image: radial-gradient(
            ellipse 55% 105% at 44% 0,
            #000 50%,
            transparent 100%
        );
        pointer-events: none;
    }

    /* sobra um bloco à direita, para o deslize repetir sem emenda */
    .hero-water i {
        position: absolute;
        inset: 0 -1000px 0 0;
        background: var(--accent);
        mask: url("../assets/water-surface.svg") 0 0 / 1000px 100% repeat-x;
    }

    @keyframes water-flow {
        to {
            translate: -1000px 0;
        }
    }

    .hero-cut {
        position: absolute;
        z-index: -3;
        inset: -10% auto -10% calc(34% - 1.1rem);
        width: 6px;
        background: var(--accent);
        transform: skewX(var(--skew));
    }

    /* ---- palavra gigante ao fundo: o comando selecionado ---- */
    .hero-bigword {
        position: absolute;
        z-index: -3;
        right: -0.5rem;
        bottom: 20%;
        font-family: var(--font-display);
        font-style: italic;
        font-weight: 900;
        text-transform: uppercase;
        line-height: 0.8;
        font-size: clamp(5rem, 11vw, 11rem);
        letter-spacing: -0.02em;
        color: color-mix(in srgb, var(--ink) 6%, transparent);
        -webkit-text-stroke: 2px color-mix(in srgb, var(--ink) 20%, transparent);
        white-space: nowrap;
        pointer-events: none;
        rotate: -6deg;
        transform-origin: right bottom;
    }

    /* troca rápida e seca, como o corte do menu do jogo */
    .hero-bigword:global(.swap) {
        animation: bigword-in 0.32s cubic-bezier(0.2, 0.9, 0.2, 1);
    }

    @keyframes bigword-in {
        from {
            translate: 12% 0;
            opacity: 0;
        }
    }

    /* ---- retrato ---- */
    .hero-stripes {
        position: absolute;
        z-index: -2;
        left: calc(max(1rem, 5vw) + 4rem);
        top: calc(var(--hud-h) - 2rem);
        bottom: -2rem;
        display: none;
        gap: 0.9rem;
        transform: skewX(var(--skew));
        transform-origin: bottom;
    }

    .hero-stripes span {
        width: 14px;
        background: var(--azure);
        opacity: 0.55;
    }

    .hero-stripes span:nth-child(2) {
        width: 54px;
        background: color-mix(in srgb, var(--azure) 70%, var(--deep));
        opacity: 0.6;
    }

    .hero-stripes span:nth-child(3) {
        width: 5px;
        background: var(--ink);
        opacity: 0.45;
    }

    .hero-photo {
        position: absolute;
        z-index: -1;
        left: max(2rem, 7vw);
        top: calc(var(--hud-h) + 4.5rem);
        width: clamp(13rem, 21vw, 19rem);
        aspect-ratio: 3 / 4.6;
        overflow: hidden;
        background: linear-gradient(180deg, var(--royal), var(--deep));
        box-shadow:
            inset 0 0 0 2px rgb(244 247 255 / 0.5),
            14px 14px 0 var(--drop);
        display: none;
    }

    .hero-photo > * {
        position: absolute;
        inset: auto -30% 0;
        width: 160%;
        height: 82%;
    }

    /* figura recortada: sombra azul deslocada (como os retratos dos cut-ins) */
    .hero-figure {
        position: absolute;
        z-index: -1;
        left: max(1rem, 5vw);
        bottom: 0;
        display: none;
        width: auto;
        height: calc(100% - var(--hud-h) - 1.5rem);
        max-width: none;
        filter: drop-shadow(18px -12px 0 var(--azure));
        pointer-events: none;
    }

    /* ---- conteúdo ---- */
    .hero-grid {
        display: grid;
        gap: 1.5rem;
        align-content: center;
    }

    .hero-plate {
        position: relative;
        display: grid;
        justify-items: start;
        gap: 0.3rem;
    }

    .hero-plate h1 {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem 0.9rem;
        font-weight: 900;
    }

    .hero-lv {
        font-size: 1.15rem;
    }

    .hero-name {
        font-size: clamp(2.4rem, 1.6rem + 3.6vw, 4rem);
        text-transform: uppercase;
        line-height: 0.9;
        text-shadow: 0.06em 0.06em 0 var(--royal);
    }

    .hero-role {
        color: var(--muted);
        font-size: var(--step-1);
    }

    /* celular: busto recortado ao lado do nome, num recorte inclinado */
    .hero-mbust {
        position: absolute;
        top: -0.25rem;
        right: 0;
        width: 6.5rem;
        height: 7.5rem;
        overflow: hidden;
        background: linear-gradient(180deg, var(--royal), var(--deep));
        clip-path: polygon(22% 0, 100% 0, 100% 100%, 0 100%);
    }

    .hero-mbust img {
        width: 100%;
        height: auto;
        margin-top: 0.4rem;
        filter: drop-shadow(6px -4px 0 var(--azure));
    }

    .hero-menu {
        transform: rotate(-4deg);
        transform-origin: left center;
        padding-block: 0.5rem;
    }

    /* o menu escala pela largura e pela altura: em telas baixas encolhe para o hero caber na primeira tela */
    .hero-menu :global(.cmd a) {
        font-size: clamp(1.9rem, min(1.5rem + 2.2vw, 4.4vh), 3.3rem);
    }

    .hero-menu :global(.cmd li) {
        margin-left: calc(var(--i) * clamp(0.6rem, 2vw, 2rem));
    }

    :global(.hero-dialog) {
        max-width: 38rem;
        padding-bottom: 1.2rem !important;
    }

    /* no hero a fala fica um pouco mais compacta, para caber na primeira tela */
    :global(.hero-dialog) p {
        font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem) !important;
    }

    /* escolhas: no celular ficam dentro da fala, logo abaixo do texto */
    .hero-choices {
        margin-top: 1.4rem;
        padding: 1.5rem 1rem 1.1rem !important;
    }

    .hero-choices :global(.choice-list a) {
        font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
    }

    .hero-side {
        display: grid;
        justify-items: start;
        gap: 0.75rem;
    }

    /* tamanho fixo: trocar o texto da ajuda não mexe no layout */
    .hero-help {
        width: min(100%, 28rem);
        padding: 0.6rem 1.1rem;
        border-left: 4px solid var(--accent);
        background: var(--panel);
        color: var(--soft);
        min-height: calc(3.2em + 1.2rem);
    }

    /* prompts de botão como no canto do jogo: rótulos em itálico, o principal em ciano */
    .hero-keys {
        display: none;
        align-items: center;
        gap: 1.1rem;
        font-family: var(--font-display);
        font-style: italic;
        font-weight: 700;
        font-size: 1.25rem;
    }

    .hero-key-main {
        color: var(--accent);
    }

    .hero-keys > span {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
    }

    /* celular: o painel azul fica à direita para a linha de corte não cruzar o menu */
    @media (max-width: 59.99rem) {
        .hero-panel {
            left: 72%;
        }

        .hero-cut {
            left: calc(72% - 1.1rem);
        }

        /* numa faixa estreita e inclinada a água não forma o leque; fica só no desktop */
        .hero-water {
            display: none;
        }

        .hero-plate {
            padding-right: 7.25rem;
            min-height: 7rem;
        }

        .hero-bigword {
            font-size: clamp(3.5rem, 18vw, 6rem);
            bottom: 4%;
        }
    }

    /* ---- desktop: a composição do jogo ---- */
    @media (min-width: 60rem) {
        .hero-photo,
        .hero-figure {
            display: block;
        }

        .hero-stripes {
            display: flex;
        }

        .hero-mbust {
            display: none;
        }

        .hero-grid {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
            grid-template-areas:
                ". plate"
                ". menu"
                "dialog side";
            column-gap: 3rem;
        }

        .hero-plate {
            grid-area: plate;
            justify-items: end;
            text-align: right;
        }

        .hero-plate h1 {
            justify-content: flex-end;
        }

        /* no desktop, cargo e menu ficam sobre as manchas claras da água: cores sólidas e sombra para separar */
        .hero-role {
            color: var(--soft);
            text-shadow: 0.08em 0.08em 0 var(--deep);
        }

        .hero-menu {
            grid-area: menu;
            justify-self: end;
            transform: rotate(-6deg);
            margin-right: 2rem;
        }

        .hero-menu :global(.cmd a:not(.is-selected, :hover, :focus-visible)) {
            color: var(--muted);
            text-shadow: 0.05em 0.05em 0 var(--deep);
        }

        :global(.hero-dialog) {
            grid-area: dialog;
            align-self: end;
        }

        /* desktop: a caixa de escolhas sai de cima da fala, à direita, como no jogo */
        .hero-choices {
            position: absolute;
            right: -2.5rem;
            bottom: calc(100% + 1.4rem);
            width: 17rem;
            margin: 0;
        }

        .hero-side {
            grid-area: side;
            justify-items: end;
            align-self: end;
        }
    }

    @media (min-width: 60rem) and (pointer: fine) {
        .hero-keys {
            display: flex;
        }
    }

    /* a água desliza de lado, sem movimento reduzido.
       Só translate: roda no compositor, sem repintar */
    @media (min-width: 60rem) and (prefers-reduced-motion: no-preference) {
        .hero-water i {
            animation: water-flow 120s linear infinite;
        }

        /* fora da tela, pausa */
        .hero:global(.is-away) .hero-water i {
            animation-play-state: paused;
        }
    }

    /* notebooks com tela baixa (768/720px): espaçamentos mais justos para a fala caber */
    @media (min-width: 60rem) and (max-height: 50rem) {
        .hero {
            padding-top: calc(var(--hud-h) + env(safe-area-inset-top) + 0.5rem);
        }

        .hero-grid {
            gap: 0.75rem;
        }

        .hero-name {
            font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.2rem);
        }

        .hero-menu {
            padding-block: 0;
        }
    }

    @media (max-height: 34rem) and (orientation: landscape) {
        .hero {
            min-height: auto;
        }

        .hero-photo,
        .hero-figure,
        .hero-stripes,
        .hero-bigword {
            display: none;
        }
    }

    /* ================= Entrada (uma vez, ao carregar) =================
       "hero-pending" esconde as peças até o boot terminar; "hero-in" dispara a sequência.
       Sem JS ou com movimento reduzido, nada disso acontece e tudo já aparece pronto. */
    /* global: o diálogo vem do componente Talk e não carrega o escopo deste arquivo */
    :global(html.hero-pending .hero .hero-enter),
    :global(html.hero-pending .hero .hero-menu li) {
        opacity: 0;
    }

    :global(html.hero-in) .hero-panel {
        animation: hero-wipe 0.55s cubic-bezier(0.7, 0, 0.2, 1) both;
    }

    :global(html.hero-in) .hero-cut {
        animation: hero-wipe 0.55s cubic-bezier(0.7, 0, 0.2, 1) 0.08s both;
    }

    :global(html.hero-in) .hero-water {
        animation: hero-fade 0.8s ease 0.5s both;
    }

    :global(html.hero-in) .hero-stripes {
        animation: hero-stripe 0.45s cubic-bezier(0.2, 0.9, 0.2, 1) 0.15s both;
    }

    :global(html.hero-in) .hero-figure {
        animation: hero-from-left 0.55s cubic-bezier(0.2, 0.9, 0.2, 1) 0.22s
            both;
    }

    :global(html.hero-in) .hero-plate {
        animation: hero-from-right 0.45s cubic-bezier(0.2, 0.9, 0.2, 1) 0.3s
            both;
    }

    :global(html.hero-in) .hero-menu :global(li) {
        animation: hero-from-right 0.4s cubic-bezier(0.2, 0.9, 0.2, 1)
            calc(0.38s + var(--i) * 0.06s) both;
    }

    :global(html.hero-in) :global(.hero-dialog) {
        animation: hero-rise 0.45s cubic-bezier(0.2, 0.9, 0.2, 1) 0.6s both;
    }

    :global(html.hero-in) .hero-side {
        animation: hero-fade 0.4s ease 0.8s both;
    }

    @keyframes hero-wipe {
        from {
            translate: 110% 0;
        }
    }

    @keyframes hero-stripe {
        from {
            scale: 1 0;
        }
    }

    @keyframes hero-from-left {
        from {
            translate: -14% 0;
            opacity: 0;
        }
    }

    @keyframes hero-from-right {
        from {
            translate: 70px 0;
            opacity: 0;
        }
    }

    @keyframes hero-rise {
        from {
            translate: 0 28px;
            opacity: 0;
        }
    }

    @keyframes hero-fade {
        from {
            opacity: 0;
        }
    }
</style>
