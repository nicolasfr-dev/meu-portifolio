---
import { achievements, totalPoints } from '../data/achievements';
import type { Lang } from '../data/profile';
import { useT } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
---

<dialog class="modal achievements" id="achievements-dialog" aria-labelledby="ach-title">
	<div class="ach-body modal-body">
		<div class="modal-head">
			<h2 id="ach-title">{t('achievements.title')}</h2>
			<button class="icon-btn" type="button" data-close aria-label={t('achievements.close')}>✕</button>
		</div>

		<div class="ach-summary">
			<p>
				<strong data-ach-count>0/{achievements.length}</strong>
				{t('achievements.progress')}
				<span class="ach-pts"><span data-score>0000</span> / {totalPoints}</span>
			</p>
			<div class="bar" data-ach-progress style="--value:0"></div>
		</div>

		<ul class="ach-list" role="list">
			{
				achievements.map((a) => (
					<li class="ach" data-ach={a.id} data-locked data-secret={a.secret ? '' : undefined}>
						<div class="ach-text">
							<strong class="ach-name">
								<span class="ach-real">{a.name[lang]}</span>
								{a.secret && <span class="ach-mask">???</span>}
							</strong>
							<span class="ach-desc">
								<span class="ach-real">{a.desc[lang]}</span>
								{a.secret && <span class="ach-mask">{t('achievements.secret')}</span>}
							</span>
						</div>
						<span class="ach-points">+{a.points}</span>
					</li>
				))
			}
		</ul>

		<button class="btn btn--sm btn--ghost ach-reset" type="button" data-reset><span>{t('achievements.reset')}</span></button>
	</div>
</dialog>

<style is:global>
	.ach-body {
		background: linear-gradient(160deg, var(--azure), var(--royal) 50%, var(--deep));
		box-shadow: 10px 10px 0 var(--shadow);
	}

	.ach-summary {
		display: grid;
		gap: 0.6rem;
		margin-bottom: 1.25rem;
		color: var(--muted);
	}

	.ach-summary strong {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 900;
		font-size: 1.4rem;
		color: var(--ink);
	}

	.ach-pts {
		float: right;
		font-family: var(--font-display);
		font-weight: 700;
		color: var(--accent);
	}

	.ach-list {
		display: grid;
		gap: 0.4rem;
		padding: 0;
		list-style: none;
	}

	.ach {
		position: relative;
		z-index: 0;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 1rem;
		padding: 0.6rem 1.2rem;
	}

	.ach::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--ink);
		transform: skewX(var(--skew));
	}

	.ach-text {
		display: grid;
		min-width: 0;
		line-height: 1.3;
		color: var(--night);
	}

	.ach-name {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 800;
		font-size: 1.25rem;
	}

	.ach-desc {
		font-size: var(--step--1);
		color: color-mix(in srgb, var(--royal) 75%, var(--night));
	}

	.ach-points {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 900;
		font-size: 1.3rem;
		color: var(--royal);
	}

	.ach-mask {
		display: none;
	}

	.ach[data-locked]::before {
		background: var(--panel);
		box-shadow: inset 0 0 0 1px var(--line);
	}

	.ach[data-locked] .ach-text,
	.ach[data-locked] .ach-points {
		color: var(--muted);
	}

	.ach[data-locked] .ach-desc {
		color: color-mix(in srgb, var(--muted) 70%, transparent);
	}

	.ach[data-locked][data-secret] .ach-real {
		display: none;
	}

	.ach[data-locked][data-secret] .ach-mask {
		display: inline;
	}

	.ach.is-new::before {
		animation: ach-new 0.7s ease 2;
	}

	@keyframes ach-new {
		50% {
			background: var(--accent);
		}
	}

	.ach-reset {
		margin-top: 1.5rem;
		margin-left: 0.4rem;
	}
</style>
