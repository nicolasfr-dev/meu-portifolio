---
import StageHead from './StageHead.astro';
import { quests, type Lang } from '../data/profile';
import { useT } from '../i18n/ui';

const lang = Astro.props.lang as Lang;
const t = useT(lang);
const types = [...new Set(quests.map((q) => q.type))];
---

<section class="stage" id="quests" data-stage aria-labelledby="quests-title">
	<div class="container">
		<StageHead id="quests-title" title={t('quests.title')} help={t('help.quests')} />

		{
			/* filtro só faz sentido com mais de um tipo de projeto */
			types.length > 1 && (
				<div class="filters" role="group" aria-label={t('a11y.filter')} data-reveal>
					<button type="button" data-filter="all" aria-pressed="true">
						<span>{t('quests.all')}</span>
					</button>
					{types.map((type) => (
						<button type="button" data-filter={type} aria-pressed="false">
							<span>{t(`quests.type.${type}`)}</span>
						</button>
					))}
				</div>
			)
		}

		<ul class="requests" role="list">
			{
				quests.map((q) => (
					<li class:list={['req-wrap', { 'req-wrap--featured': q.featured }]} data-quest-type={q.type}>
						<article class="req" data-reveal>
							<header class="req-top">
								<span class="tag">
									<span>{t(`quests.type.${q.type}`)}</span>
								</span>
								<span class:list={['req-status', `req-status--${q.status}`]}>
									{t(q.status === 'done' ? 'quests.done' : 'quests.progress')}
								</span>
							</header>

							{q.featured && <p class="req-featured">{t('quests.featured')}</p>}
							<h3 class="req-title">{q.title[lang]}</h3>
							<p class="req-summary">{q.summary[lang]}</p>

							<dl class="req-info">
								<div>
									<dt>{t('quests.difficulty')}</dt>
									<dd class="req-diff" role="img" aria-label={`${q.difficulty}/5`}>
										{Array.from({ length: 5 }, (_, i) => (
											<i class={i < q.difficulty ? 'on' : undefined} />
										))}
									</dd>
								</div>
								<div>
									<dt>{t('quests.loot')}</dt>
									<dd>
										<ul class="loot" role="list">
											{q.loot.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									</dd>
								</div>
							</dl>

							{(q.repo || q.demo || q.links?.length) && (
								<div class="req-links">
									{q.demo && (
										<a class="btn btn--sm" href={q.demo} target="_blank" rel="noopener" data-quest-link>
											<span>{t('quests.demo')}</span>
										</a>
									)}
									{q.repo && (
										<a class="btn btn--sm btn--ghost" href={q.repo} target="_blank" rel="noopener" data-quest-link>
											<span>{t('quests.repo')}</span>
										</a>
									)}
									{q.links?.map((link) => (
										<a class="btn btn--sm btn--ghost" href={link.url} target="_blank" rel="noopener" data-quest-link>
											<span>{link.label[lang]}</span>
										</a>
									))}
								</div>
							)}
						</article>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	/* abas do filtro: inclinadas, a ativa fica branca */
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: clamp(1rem, 2.5vw, 1.5rem);
		padding-left: 0.4rem;
	}

	.filters button {
		min-height: 2.5rem;
		padding: 0 1.1rem;
		background: var(--panel);
		box-shadow: inset 0 0 0 1px var(--line);
		color: var(--muted);
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 800;
		font-size: 1.15rem;
		transform: skewX(var(--skew));
		transition: background 0.12s, color 0.12s;
	}

	.filters button > span {
		display: inline-block;
		transform: skewX(var(--unskew));
	}

	.filters button:hover {
		color: var(--ink);
	}

	.filters button[aria-pressed='true'] {
		background: var(--ink);
		color: var(--night);
		box-shadow: 5px 5px 0 var(--accent);
	}

	/* flex: os cards abaixo do destaque dividem a linha toda, sem sobrar coluna vazia */
	.requests {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(1rem, 2.5vw, 1.5rem);
		padding: 0;
		list-style: none;
	}

	.req-wrap {
		flex: 1 1 20rem;
		display: grid;
		container-type: inline-size;
	}

	.req-wrap[hidden] {
		display: none;
	}

	.req-wrap--featured {
		flex-basis: 100%;
	}

	.req {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: clamp(1rem, 2.5vw, 1.4rem);
		background: var(--panel);
		border-radius: 6px;
		box-shadow: inset 0 0 0 1px var(--line);
		transition: box-shadow 0.15s;
	}

	.req:hover {
		box-shadow: inset 0 0 0 1.5px rgb(244 247 255 / 0.55);
	}

	.req-wrap--featured .req {
		background: linear-gradient(150deg, var(--azure), var(--royal) 60%, var(--deep));
		box-shadow: 10px 10px 0 var(--shadow);
	}

	.req-top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.req-top .tag {
		font-size: 0.95rem;
	}

	.req-status {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1rem;
	}

	.req-status--done {
		color: var(--good);
	}

	.req-status--progress {
		color: var(--accent);
	}

	.req-featured {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 700;
		color: var(--accent);
	}

	.req-title {
		font-size: var(--title-sm);
		font-weight: 900;
		text-transform: uppercase;
	}

	.req-wrap--featured .req-title {
		font-size: var(--title-md);
		text-shadow: 0.06em 0.06em 0 var(--deep);
	}

	.req-summary {
		color: var(--muted);
	}

	.req-wrap--featured .req-summary {
		color: var(--soft);
	}

	.req-info {
		display: grid;
		gap: 0.75rem;
		margin-top: auto;
		font-size: var(--step--1);
	}

	.req-info > div {
		display: grid;
		gap: 0.35rem;
	}

	.req-info dt {
		font-family: var(--font-display);
		font-weight: 700;
		color: var(--muted);
	}

	.req-diff {
		display: flex;
		gap: 4px;
		width: 8rem;
	}

	.req-diff i {
		flex: 1;
		height: 0.4rem;
		background: var(--track);
		transform: skewX(var(--skew));
	}

	.req-diff i.on {
		background: var(--ink);
	}

	.loot {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		padding: 0;
		list-style: none;
	}

	.loot li {
		padding: 0.1rem 0.6rem;
		background: var(--chip);
		box-shadow: inset 0 0 0 1px var(--line);
		color: var(--ink);
	}

	.req-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		padding-left: 0.4rem;
	}

	@container (min-width: 36rem) {
		.req-info {
			grid-template-columns: auto 1fr;
			gap: 2rem;
		}
	}

	/* request principal larga: texto à esquerda, detalhes à direita */
	@container (min-width: 50rem) {
		.req-wrap--featured .req {
			display: grid;
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
			column-gap: 3rem;
			align-items: start;
		}

		.req-wrap--featured .req > :not(.req-info, .req-links) {
			grid-column: 1;
		}

		.req-wrap--featured .req-info {
			grid-column: 2;
			grid-row: 1 / span 4;
			grid-template-columns: 1fr;
			gap: 1rem;
			margin-top: 0;
		}

		.req-wrap--featured .req-links {
			grid-column: 1;
		}
	}
</style>
