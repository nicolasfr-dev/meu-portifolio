---
import type { Lang } from '../data/profile';
import { useT } from '../i18n/ui';

const t = useT(Astro.props.lang as Lang);
---

<div class="boot" aria-hidden="true">
	<div class="boot-inner">
		<p class="boot-clock">
			<span class="boot-before">23:59</span>
			<span class="boot-after">0:00</span>
		</p>
		<p class="boot-line">{t('boot.line')}</p>
		<p class="boot-press">{t('boot.press')}</p>
	</div>
</div>

<style is:global>
	.boot {
		display: none;
	}

	html.booting body {
		overflow: hidden;
	}

	html.booting .boot {
		position: fixed;
		inset: 0;
		z-index: 999;
		display: grid;
		place-items: center;
		padding: 1.5rem;
		background: #000;
		animation: boot-sky 0.6s ease 1s forwards;
	}

	/* à meia-noite o céu vira o azul da Hora Sombria */
	@keyframes boot-sky {
		to {
			background: var(--night);
		}
	}

	html.boot-out .boot {
		animation: boot-out 0.45s ease forwards;
	}

	@keyframes boot-out {
		to {
			transform: translateX(-100%);
		}
	}

	.boot-inner {
		display: grid;
		justify-items: center;
		gap: 0.75rem;
		text-align: center;
	}

	.boot-clock {
		display: grid;
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 900;
		font-size: clamp(5rem, 22vw, 12rem);
		line-height: 0.9;
		font-variant-numeric: tabular-nums;
	}

	.boot-clock span {
		grid-area: 1 / 1;
	}

	.boot-before {
		color: #8a8a8a;
		animation: boot-hide 0.01s linear 0.9s forwards;
	}

	.boot-after {
		opacity: 0;
		color: var(--ink);
		text-shadow: 0.05em 0.05em 0 var(--royal);
		animation: boot-show 0.01s linear 0.9s forwards;
	}

	.boot-line {
		opacity: 0;
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 700;
		font-size: clamp(1.25rem, 4vw, 2rem);
		color: var(--accent);
		animation: boot-show 0.4s ease 1.2s forwards;
	}

	.boot-press {
		color: var(--muted);
		font-size: var(--step--1);
	}

	@keyframes boot-hide {
		to {
			opacity: 0;
		}
	}

	@keyframes boot-show {
		to {
			opacity: 1;
		}
	}
</style>
