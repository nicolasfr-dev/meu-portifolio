---
import StageHead from './StageHead.astro';
import TechIcon from './TechIcon.astro';
import { inventory, type Lang } from '../data/profile';
import { useT } from '../i18n/ui';

const lang = Astro.props.lang as Lang;
const t = useT(lang);
---

<section class="stage" id="inventory" data-stage aria-labelledby="inventory-title">
	<div class="container">
		<StageHead id="inventory-title" title={t('inventory.title')} help={t('help.inventory')} />

		<div class="equip">
			{
				inventory.map((group) => (
					<div class="equip-group" data-reveal>
						<h3 class="equip-slot">
							<span class="tag">
								<span>{group.slot[lang]}</span>
							</span>
							{group.category[lang]}
						</h3>
						<ul class="equip-list" role="list">
							{group.items.map((item) => (
								<li class="equip-item">
									<span class="equip-icon" aria-hidden="true">
										<TechIcon slug={item.icon} fallback={item.abbr ?? item.name} class="equip-logo" />
									</span>
									<span class="equip-name">{item.name}</span>
									<span class="equip-lv" aria-label={`${t('inventory.level')} ${item.level}/5`}>
										<span aria-hidden="true">Lv</span>
										{item.level}
									</span>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	/* slots lado a lado, como as colunas da tela de equipar */
	.equip {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
		gap: clamp(1.25rem, 3vw, 2rem);
		align-items: start;
	}

	.equip-slot {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
		font-size: var(--title-sm);
		font-weight: 900;
		text-transform: uppercase;
	}

	.equip-slot .tag {
		font-size: 1rem;
		text-transform: none;
	}

	.equip-list {
		display: grid;
		gap: 0.4rem;
		padding: 0;
		list-style: none;
	}

	.equip-item {
		position: relative;
		display: grid;
		grid-template-columns: 2.6rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.85rem;
		padding: 0.35rem 1.1rem 0.35rem 0.4rem;
		isolation: isolate;
		transition: color 0.12s;
	}

	.equip-item::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--panel);
		box-shadow: inset 0 0 0 1px var(--line);
		transform: skewX(var(--skew));
		transition: background 0.12s, box-shadow 0.12s;
	}

	.equip-item:hover {
		color: var(--night);
	}

	.equip-item:hover::before {
		background: var(--ink);
		box-shadow: 6px 6px 0 var(--accent);
	}

	.equip-icon {
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.2rem;
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 900;
		font-size: 1rem;
		color: var(--night);
		background: var(--accent);
		transform: skewX(var(--skew));
	}

	/* o logo fica reto dentro da tarja inclinada */
	.equip-icon :global(.equip-logo) {
		width: 1.25rem;
		height: 1.25rem;
		transform: skewX(var(--unskew));
	}

	.equip-name {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 700;
		font-size: 1.3rem;
		line-height: 1.1;
	}

	.equip-lv {
		display: inline-flex;
		align-items: baseline;
		gap: 0.25rem;
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 900;
		font-size: 1.5rem;
		line-height: 1;
	}

	.equip-lv span {
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--accent);
	}

	.equip-item:hover .equip-lv span {
		color: var(--royal);
	}
</style>
